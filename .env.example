# Nutrogan — variables públicas (Vite / Quasar)
# Copiá a .env y completá. Nunca subas .env al repo.

VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_KEY=eyJ...anon_public_key

# La IA (Gemini) vive solo en Edge Functions de Supabase (secret GOOGLE_API_KEY).
# NO configures VITE_GEMINI_API_KEY: Vite lo embebe en el bundle del cliente.
